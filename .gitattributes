# Normalize line endings across platforms
* text=auto eol=lf

# Explicit text files
*.html   text
*.css    text
*.js     text
*.json   text
*.md     text
*.txt    text
*.svg    text

# Binary assets — never touch these
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
